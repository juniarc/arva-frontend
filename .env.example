# Base URL of the Arva backend (Node.js + Express). No trailing slash needed.
# Server-only: it is read by Route Handlers and never sent to the browser,
# so it intentionally has no NEXT_PUBLIC_ prefix.
API_BASE_URL=http://localhost:4000

# Where the address form gets provinces, cities, districts and sub-districts (https://wilayah.id).
# Server-only. Optional: this is the default.
# REGIONS_API_BASE_URL=https://wilayah.id

# DEV ONLY. "true" makes Pay Now show the "Order received" screen without calling the backend, so the
# success UI can be tested before payments exist. It is ignored in production builds. Leave it unset otherwise.
# NEXT_PUBLIC_CHECKOUT_DEV_SUCCESS=true
