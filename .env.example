# Base URL of the Arva backend API (Node.js + Express), including /api. No trailing slash.
# Server-only: it is read by Server Components and Route Handlers and never sent to the browser,
# so it intentionally has no NEXT_PUBLIC_ prefix. On Vercel, set it to the deployed backend's public URL.
API_BASE_URL=http://localhost:4000/api

# Where the address form gets provinces, cities, districts and sub-districts (https://wilayah.id).
# Server-only. Optional: this is the default.
# REGIONS_API_BASE_URL=https://wilayah.id
